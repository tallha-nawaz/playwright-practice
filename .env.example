# Copy this file to .env and fill in real values. Never commit .env.

# Optional: override the SauceDemo base URL.
SAUCEDEMO_BASE_URL=https://www.saucedemo.com/

# Google Drive upload configuration
# Provide EITHER a path to a service account JSON key file...
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json
# ...OR the raw JSON contents of the key (useful for CI secrets). Leave unset if using the path above.
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account", ...}

# The Drive folder to upload into (personal "My Drive" folder shared with the
# service account's email, or a Shared Drive folder). Copy the ID from the
# folder's URL: https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GOOGLE_DRIVE_FOLDER_ID=
